# Copy to .env.local and fill in.

# PayHere → Side Menu → Integrations. The merchant secret is issued per domain,
# so sandbox and live (and each domain) have different secrets.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# "true" uses https://sandbox.payhere.lk, anything else uses live.
PAYHERE_SANDBOX=true

# Public URL of this site, no trailing slash. PayHere posts payment results to
# $SITE_URL/api/payhere/notify, so it must be reachable from the internet
# (use an ngrok/cloudflared tunnel URL when testing locally).
SITE_URL=http://localhost:3000
